# VULNEX local settings. Copy this file to .env and fill in your values.
# Never put a MetaMask private key or seed phrase here or anywhere in this project.

# Public address of your deployed AuditRegistry contract on Ethereum Sepolia.
# Leave empty until you deploy it (the Report page can deploy it for you through MetaMask).
AUDIT_REGISTRY_ADDRESS=

# OpenRouter key for AI fix suggestions. Read only by the local server; never sent to the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Optional
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# PORT=5173
